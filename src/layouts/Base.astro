---
import { RUN, REPO, NPM } from '../data/benchmark';

interface Props {
  readonly title: string;
  readonly description: string;
  readonly canonical: string;
}

const { title, description, canonical } = Astro.props;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://agentchaperone.dev/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="color-scheme" content="dark light" />
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <header class="bar">
      <nav aria-label="Primary">
        <a class="wordmark" href="/">
          agent-chaperone
        </a>
        <div class="bar-links">
          <a href="/results">Results</a>
          <a href={REPO}>Source</a>
          <a href={NPM}>npm</a>
        </div>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="foot">
      <div class="foot-cols">
        <div>
          <h2>Project</h2>
          <ul>
            <li>
              <a href={REPO}>Repository</a>
            </li>
            <li>
              <a href={NPM}>Package</a>
            </li>
            <li>
              <a href={`${REPO}/releases`}>Releases</a>
            </li>
            <li>
              <a href={`${REPO}/blob/main/ROADMAP.md`}>Roadmap</a>
            </li>
          </ul>
        </div>
        <div>
          <h2>Documentation</h2>
          <ul>
            <li>
              <a href={`${REPO}#readme`}>README</a>
            </li>
            <li>
              <a href={`${REPO}/blob/main/docs/design.md`}>Design</a>
            </li>
            <li>
              <a href={`${REPO}/blob/main/docs/hooks.md`}>Hooks</a>
            </li>
            <li>
              <a href={`${REPO}/tree/main/docs/adr`}>Decision records</a>
            </li>
          </ul>
        </div>
        <div>
          <h2>Evidence</h2>
          <ul>
            <li>
              <a href="/results">Measured results</a>
            </li>
            <li>
              <a href={`${REPO}/tree/main/bench`}>Methodology</a>
            </li>
            <li>
              <a href={`${REPO}/blob/main/bench/results/report.txt`}>Scorer output</a>
            </li>
            <li>
              <a href={`${REPO}/blob/main/bench/results/cache.jsonl`}>Recorded responses</a>
            </li>
          </ul>
        </div>
        <div>
          <h2>Security</h2>
          <ul>
            <li>
              <a href={`${REPO}/blob/main/SECURITY.md`}>Security policy</a>
            </li>
            <li>
              <a href={`${REPO}/security/advisories/new`}>Report a vulnerability</a>
            </li>
            <li>
              <a href={`${REPO}/blob/main/LICENSE`}>Apache-2.0</a>
            </li>
          </ul>
        </div>
      </div>
      <p class="provenance">
        This page describes agent-chaperone {RUN.toolVersion}. The measured numbers are one run of
        <code>{RUN.model}</code> on {RUN.date}. Copyright {year}, Apache-2.0.
      </p>
    </footer>
  </body>
</html>

<style is:global>
  /* One stylesheet, no framework, no client JavaScript anywhere on this site.
     That is what makes script-src 'none' an honest header rather than a pose. */
  :root {
    --bg: #0c0d10;
    --panel: #131519;
    --line: #23262d;
    --ink: #e6e8ec;
    --ink-dim: #a0a6b0;
    --ink-faint: #737a86;
    --accent: #7fb2ff;
    --warn: #e0b341;
    --stop: #e2705f;
    --ok: #6cc08a;
    --mono: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace;
    --sans:
      ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Inter, Helvetica, Arial, sans-serif;
    --measure: 68ch;
  }

  @media (prefers-color-scheme: light) {
    :root:not([data-theme='dark']) {
      --bg: #fbfbfc;
      --panel: #f2f3f5;
      --line: #dcdfe4;
      --ink: #14161a;
      --ink-dim: #4a515c;
      --ink-faint: #6e7683;
      --accent: #1f5fd0;
      --warn: #8a6100;
      --stop: #b4341f;
      --ok: #1d7a49;
    }
  }

  * {
    box-sizing: border-box;
  }

  html {
    -webkit-text-size-adjust: 100%;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 17px;
    line-height: 1.6;
    text-rendering: optimizeLegibility;
  }

  .skip {
    position: absolute;
    left: -9999px;
  }
  .skip:focus {
    left: 1rem;
    top: 1rem;
    background: var(--panel);
    padding: 0.5rem 0.75rem;
    z-index: 10;
  }

  a {
    color: var(--accent);
    text-underline-offset: 3px;
  }
  a:hover {
    text-decoration-thickness: 2px;
  }

  code {
    font-family: var(--mono);
    font-size: 0.92em;
  }

  main {
    max-width: 82ch;
    margin: 0 auto;
    padding: 0 16px 4rem;
  }

  section {
    padding: 2.5rem 0;
    border-top: 1px solid var(--line);
  }
  section:first-of-type {
    border-top: 0;
  }

  h1,
  h2,
  h3 {
    line-height: 1.25;
    letter-spacing: -0.015em;
    margin: 0 0 0.75rem;
  }
  h1 {
    font-size: clamp(1.9rem, 5vw, 2.7rem);
  }
  h2 {
    font-size: 1.35rem;
  }
  h3 {
    font-size: 1.05rem;
  }
  p,
  li {
    max-width: var(--measure);
  }
  p {
    margin: 0 0 1rem;
  }

  .lede {
    font-size: 1.1rem;
    color: var(--ink-dim);
  }
  .note {
    color: var(--ink-faint);
    font-size: 0.92rem;
  }

  .bar {
    border-bottom: 1px solid var(--line);
    background: var(--bg);
  }
  .bar nav {
    max-width: 82ch;
    margin: 0 auto;
    padding: 0.9rem 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .wordmark {
    font-family: var(--mono);
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
  }
  .bar-links {
    display: flex;
    gap: 1.1rem;
    font-size: 0.95rem;
  }

  pre {
    font-family: var(--mono);
    font-size: 0.86rem;
    line-height: 1.55;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 0.9rem 1rem;
    overflow-x: auto;
    margin: 0 0 1rem;
  }
  pre code {
    font-size: inherit;
  }

  .term {
    white-space: pre;
  }
  .term .fwd {
    color: var(--ink-faint);
  }
  .term .would {
    color: var(--warn);
  }
  .term .held {
    color: var(--stop);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.93rem;
    margin: 0 0 1rem;
    display: block;
    overflow-x: auto;
  }
  th,
  td {
    text-align: left;
    padding: 0.55rem 0.7rem;
    border-bottom: 1px solid var(--line);
    white-space: nowrap;
  }
  th {
    color: var(--ink-dim);
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: 0.02em;
  }
  td.num,
  th.num {
    text-align: right;
    font-family: var(--mono);
    font-variant-numeric: tabular-nums;
  }
  tbody tr:last-child td {
    border-bottom: 0;
  }
  caption {
    text-align: left;
    color: var(--ink-faint);
    font-size: 0.88rem;
    padding-bottom: 0.5rem;
  }

  .callout {
    border: 1px solid var(--line);
    border-left: 3px solid var(--warn);
    background: var(--panel);
    padding: 1rem 1.1rem;
    border-radius: 0 6px 6px 0;
    margin: 0 0 1rem;
  }
  .callout p:last-child {
    margin-bottom: 0;
  }

  ul.plain {
    list-style: none;
    padding: 0;
  }
  ul.plain > li {
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--line);
  }
  ul.plain > li:last-child {
    border-bottom: 0;
  }
  ul.plain b {
    color: var(--ink);
  }

  .foot {
    border-top: 1px solid var(--line);
    background: var(--panel);
    padding: 2.5rem 16px 3rem;
  }
  .foot-cols {
    max-width: 82ch;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1.5rem;
  }
  .foot h2 {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-faint);
    margin-bottom: 0.5rem;
  }
  .foot ul {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.92rem;
  }
  .foot li {
    padding: 0.2rem 0;
  }
  .provenance {
    max-width: 82ch;
    margin: 2rem auto 0;
    color: var(--ink-faint);
    font-size: 0.85rem;
  }

  .anchor {
    color: var(--ink-faint);
    text-decoration: none;
    font-weight: 400;
    margin-left: 0.4rem;
    opacity: 0;
  }
  h2:hover .anchor,
  h3:hover .anchor,
  .anchor:focus {
    opacity: 1;
  }

  @media (max-width: 34rem) {
    body {
      font-size: 16px;
    }
    section {
      padding: 2rem 0;
    }
  }
</style>
